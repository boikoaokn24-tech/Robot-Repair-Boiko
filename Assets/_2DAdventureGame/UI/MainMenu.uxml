<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="GameUI.uss" />
  <ui:VisualElement class="root">
    <ui:VisualElement class="end">
      <ui:VisualElement class="end-card">
        <ui:Label text="ROBOT REPAIR" class="title" />
        <ui:Label text="Полагодь усіх роботів у саду, ухиляючись від небезпек." class="body" />
        <ui:Label text="WASD / стрілки — рух · C — ремонт · X — розмова з NPC" class="body" />
        <ui:Button name="StartButton" text="Почати ремонт" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
